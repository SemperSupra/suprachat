  "qualification_policy": "The typed UI exercises documented supported paths. The raw Responses console preserves arbitrary request fields so current upstream behavior can be measured. Unsupported-by-SIWC does not mean unavailable through ChatGPT product or Codex runtime.",
  "responses_websocket": {
    "endpoint": "wss://api.openai.com/v1/responses",
    "state": "supported_by_responses_and_siwc_same-connection-continuation",
    "client_event": "response.create",
    "transport_fields_not_used": [
      "stream",
      "background"
    ],
    "store": false,
    "previous_response_id": "supported only while referenced response remains in same authenticated connection cache for plan-sharing/store=false",
    "stream_id": {
      "purpose": "ordered lane and multiplexing",
      "max_named_stream_ids": 32,
      "max_active_inflight_responses": 16,
      "allowed_pattern": "letters numbers underscore hyphen period; 1-256 chars"
    },
    "connection_lifetime_minutes": 60,
    "recovery": "on reconnect/store=false replay full context or compacted input; no persisted fallback",
    "concurrency": "same stream FIFO; different streams may run concurrently",
    "qualification_needed": [
      "connect with SIWC bearer token",
      "single lane continuation",
      "parallel named streams",
      "fork",
      "previous_response_not_found",
      "60-minute reconnect"
    ]
  }
