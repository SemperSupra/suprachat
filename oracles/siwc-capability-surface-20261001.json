      "token": "https://auth.openai.com/api/accounts/oauth/token",
      "revocation": "discovered from OIDC metadata"
    },
    "token_behavior": {
      "access_token_seconds": 3600,
      "refresh_token_days": 30,
      "refresh_rotates": true,
      "offline_access_required_for_refresh": true,
      "client_secret_required": false
    }
  },
  "public_api_routes": [
    {
      "method": "GET",
      "path": "/v1/models",
      "state": "supported",
      "purpose": "account-specific visible model catalog"
    },
    {
      "method": "POST",
      "path": "/v1/responses",
      "state": "supported",
      "purpose": "eligible ChatGPT-plan inference"
    }
  ],
  "responses_http_invariants": {
    "store": false,
    "stream": true,
    "input_context": "send required context in input array",
    "explicit_system_message_item": "rejected",
    "instructions_or_developer_messages": "supported",
    "previous_response_id": "unsupported_over_http"
  },
  "supported_inputs": [
