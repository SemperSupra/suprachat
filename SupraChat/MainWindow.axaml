<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="SupraChat.MainWindow"
    Width="1280"
    Height="850"
    MinWidth="900"
    MinHeight="600"
    Title="SupraChat">
  <Grid RowDefinitions="Auto,*">
    <Border Grid.Row="0" Padding="8">
      <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto">
        <Button Grid.Column="0" Margin="0,0,6,0" Content="Back" Click="Back_Click" />
        <Button Grid.Column="1" Margin="0,0,6,0" Content="Forward" Click="Forward_Click" />
        <Button Grid.Column="2" Margin="0,0,6,0" Content="Reload" Click="Reload_Click" />
        <Button Grid.Column="3" Margin="0,0,6,0" Content="Home" Click="Home_Click" />
        <TextBlock Grid.Column="4" VerticalAlignment="Center" Text="Official ChatGPT surface + separate subscription-backed Agent Lab" />
        <Button Grid.Column="5" Content="Open in browser" Click="OpenExternal_Click" />
      </Grid>
    </Border>

    <TabControl Grid.Row="1">
      <TabItem Header="ChatGPT">
        <NativeWebView x:Name="ChatView"
                       Source="https://chatgpt.com/"
                       EnvironmentRequested="ChatView_EnvironmentRequested" />
      </TabItem>

      <TabItem Header="Agent Lab">
        <ScrollViewer>
          <StackPanel Margin="20" Spacing="10" MaxWidth="980">
            <TextBlock FontSize="22" FontWeight="SemiBold" Text="ChatGPT-plan actor interview surface" />
            <TextBlock TextWrapping="Wrap"
                       Text="This plane uses OpenAI's documented Sign in with ChatGPT flow, account-specific model catalog, eligible streamed Responses capabilities, and Codex app-server. It remains separate from the first-party ChatGPT product surface." />

            <WrapPanel Orientation="Horizontal">
              <Button x:Name="SignInButton" Margin="0,0,8,8"
                      Content="Continue with ChatGPT" Click="SignIn_Click" />
              <Button Margin="0,0,8,8" Content="Enable plan usage" Click="EnablePlanUsage_Click" />
              <Button Margin="0,0,8,8" Content="Sign out / revoke session" Click="SignOut_Click" />
            </WrapPanel>
            <TextBlock x:Name="AuthStatus" Text="Not signed in to Agent Lab." TextWrapping="Wrap" />

            <WrapPanel Orientation="Horizontal">
              <Button Margin="0,0,8,8" Content="Refresh models" Click="RefreshModels_Click" />
              <ComboBox x:Name="ModelBox" Width="360" Margin="0,0,8,8" PlaceholderText="Select a model" />
              <Button Margin="0,0,8,8" Content="Start Codex app-server" Click="StartCodex_Click" />
            </WrapPanel>

            <TextBlock FontWeight="SemiBold" Text="Interview input" />
            <TextBox x:Name="PromptBox" AcceptsReturn="True" MinHeight="110"
                     Text="Say exactly: Hello from SupraChat." />

            <WrapPanel Orientation="Horizontal">
              <Button Margin="0,0,8,8" Content="Attach image/file" Click="Attach_Click" />
              <Button Margin="0,0,8,8" Content="Clear attachments" Click="ClearAttachments_Click" />
              <CheckBox x:Name="WebSearchBox" Margin="4,4,8,8"
                        Content="Allow supported web search" />
            </WrapPanel>
            <TextBlock x:Name="AttachmentsStatus"
                       Text="No Agent Lab attachments selected."
                       TextWrapping="Wrap" />

            <Button HorizontalAlignment="Left"
                    Content="Run streamed Responses interview"
                    Click="RunInterview_Click" />
            <TextBlock FontWeight="SemiBold" Text="Result" />
            <TextBox x:Name="OutputBox" AcceptsReturn="True" IsReadOnly="True"
                     TextWrapping="Wrap" MinHeight="220" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </Grid>
</Window>
